# Values for the TURN server on the VPS.
#
# **coturn does not read this file.** It reads /etc/turnserver.conf, and these
# values are written into it by hand. This is here so there is one place to
# record what was chosen, and so the two halves that must match can be checked
# against each other without reading two machines' configuration.
#
# Copy it to .env, fill it in, and keep it off the VPS's public paths and out
# of git: .env is ignored, .env.example is not.
#
#   cp .env.example .env
#
# See SETUP-VPS.md beside this file for the whole procedure.

# ---------------------------------------------------------------------------
# Must match main-site/.env.example, which is what Vercel gets
# ---------------------------------------------------------------------------

# static-auth-secret in /etc/turnserver.conf, and TURN_SECRET in Vercel.
# The same string in both, exactly: a trailing space counts as different, and
# the failure is every credential being rejected with
# "check_stun_auth: Cannot find credentials" in the coturn log.
#
# Generate with:  openssl rand -hex 32
#
# Treat it as a password. Anybody holding it can relay traffic through the VPS
# at your expense. Rotating it means editing the conf, restarting coturn,
# updating Vercel, and redeploying; credentials already issued stop working
# immediately, which is the point.
TURN_SECRET=

# realm in /etc/turnserver.conf, and TURN_HOST in Vercel.
TURN_HOST=turn.cue.uwuapps.org

# ---------------------------------------------------------------------------
# VPS only, not needed by Vercel
# ---------------------------------------------------------------------------

# **Your VPS's public IP**, the one the internet sees. Goes into external-ip
# in /etc/turnserver.conf. Find it by running this ON THE VPS:
#
#   curl -4 ifconfig.me
#
# This is what coturn tells the phone and the laptop to send their relayed
# traffic to, so a wrong value gives a relay that looks healthy from the
# machine itself and is unreachable from anywhere else: no relay candidate in
# Trickle ICE, and pairing across networks still failing.
#
# Most VPS providers put the public address straight on the interface, and one
# value is all you need. Some (AWS, GCP, Oracle Cloud) give the machine a
# private address and NAT it, and then coturn needs both, public first:
#
#   TURN_EXTERNAL_IP=203.0.113.10/10.0.0.5
#
# Check which you have with:  ip -4 addr show | grep inet
# An address starting 10. , 172.16-31. or 192.168. is private.
TURN_EXTERNAL_IP=

# Where certbot put the certificate for TURN_HOST. Only the turns: endpoint on
# 5349 needs it, and that is the one that gets through restrictive networks.
TURN_CERT=/etc/letsencrypt/live/turn.cue.uwuapps.org/fullchain.pem
TURN_PKEY=/etc/letsencrypt/live/turn.cue.uwuapps.org/privkey.pem

# The UDP range coturn allocates relays from. Must be open in both the
# machine's firewall and the provider's own, which are usually separate.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
