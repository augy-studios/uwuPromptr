# Real environment files. The .example ones beside them are committed and are
# the documentation; these hold the actual TURN secret and must never be.
.env
.env.*
!.env.example

# Vercel's local state.
.vercel

# Nothing here needs a package manager, so anything that turns up is a tool's
# working directory rather than part of the site. android/ has its own, and its
# own .gitignore.
node_modules/

# Secrets, wherever one is saved by mistake: the Android signing key and its
# passwords, Firebase's app config, and Firebase service account keys. *.apk is
# deliberately not here: release/<version>/*.apk is committed.
*.keystore
*.jks
*.p12
*.pfx
keystore.properties
google-services.json
*firebase-adminsdk*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# release/ keeps only the APKs (the phone's and the watch's) and its README.
# Everything else that lands there is ignored: the desktop installers that
# desktop/build-linux.sh copies in, at 80 to 110 MB each too big for GitHub,
# their latest*.yml and .blockmap files, and anything else a tool leaves. Those
# live only on the GitHub release.
release/**
!release/*/
!release/README.md
!release/*/*.apk

# The desktop installers, wherever else a build leaves them.
*.deb
*.AppImage
*.msi
*.dmg
*-setup.exe

# Editor and OS leavings.
.DS_Store
Thumbs.db
*.swp
.idea/
