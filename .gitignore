# Real environment files. The .example ones beside them are committed and are
# the documentation; these hold the actual TURN secret and must never be.
.env
.env.*
!.env.example

# Vercel's local state.
.vercel

# Nothing here needs a package manager, so anything that turns up is a tool's
# working directory rather than part of the site. flutter/ has its own .gitignore.
node_modules/

# Secrets, wherever one is saved by mistake: the Android signing key and its
# passwords, Firebase's app config, and Firebase service account keys. *.apk is
# deliberately not here: release/<version>/*.apk is committed.
*.keystore
*.jks
*.p12
*.pfx
keystore.properties
google-services.json
*firebase-adminsdk*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# release/<version>/ keeps the Android builds (release/README.md): the phone's APK, the watch's
# -watch.apk and the App Bundle for Google Play, and this README. GitHub refuses any file over
# 100 MB, so one that big is listed here by name and goes only on the GitHub release (none so far).
# The rest never goes in git: the desktop installers (GitHub Actions puts them on the release),
# their latest*.yml files, and the R8 mapping and Dart symbols that read crash reports back,
# which stay on this computer.
release/**
!release/*/
!release/README.md
!release/*/*.apk
!release/*/*.aab
release/*/*-mapping.txt
release/*/*-symbols.zip

# The desktop installers, wherever else a build leaves them.
*.deb
*.AppImage
*.msi
*.dmg
*-setup.exe

# Editor and OS leavings.
.DS_Store
Thumbs.db
*.swp
.idea/

# What's left on disk of the 1.0.0 apps, which flutter/ replaced: their keystore copy, builds and
# packages. Never committed.
/android/
/desktop/
