<!-- uwuPromptr's .msi (docs/desktop-features-spec.md §16), for Group Policy and msiexec: x64, per
     user, a MajorUpgrade so each version replaces the last, Start menu and desktop shortcuts, and
     uwu:// links. Its UpgradeCode never changes: it's the one electron-builder made for 1.0.0's .msi
     (UUID v5 of org.uwuapps.cue), so this upgrades that install in place. The app can't update an .msi install itself; it
     says when there's a new version, with a link to download it.

     Built by .github/workflows/build-desktop.yml with WiX 5:
       wix build uwupromptr.wxs -arch x64 -d Version=1.0.0 -d Source=<x64 Release folder> -o uwupromptr-1.0.0.msi -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="uwuPromptr" Manufacturer="Augy Studios" Version="$(var.Version)"
           UpgradeCode="903B6DB3-E8DB-56D7-A204-FB73FF6AE7D4" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer uwuPromptr is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(var.Source)\data\flutter_assets\assets\images\tray.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://cue.uwuapps.org" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="uwuPromptr" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.Source)\**" />
    </ComponentGroup>

    <Component Id="Shortcuts" Directory="INSTALLFOLDER" Guid="b6f2a9d4-3c71-4e58-9a0d-7e1c5f83b2a6">
      <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="uwuPromptr" Target="[INSTALLFOLDER]uwuPromptr.exe" WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="Desktop" Directory="DesktopFolder" Name="uwuPromptr" Target="[INSTALLFOLDER]uwuPromptr.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Classes\uwu" Value="URL:UwU Apps link" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\uwu" Name="URL Protocol" Value="" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\uwu\shell\open\command" Value="&quot;[INSTALLFOLDER]uwuPromptr.exe&quot; &quot;%1&quot;" Type="string" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
